# LongMemEval configuration for riki-memory
# Copy this file to longeval/.env and fill in your values.

# --- LLM Provider (any OpenAI-compatible API) ---
RIKI_API_KEY=your-api-key-here
RIKI_BASE_URL=https://api.openai.com/v1
RIKI_CHAT_MODEL=gpt-4o-mini
RIKI_FAST_MODEL=gpt-4o-mini
RIKI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
# Postgres with pgvector. `docker compose up -d` (repo root) runs this one:
RIKI_DB_URL=postgresql://riki:riki@localhost:5433/riki

# --- HuggingFace (optional, for gated datasets) ---
# HF_TOKEN=hf_...

# --- QA scoring (--judge qa) ---
# The reader answers from riki's context with LongMemEval's prompt; the judge grades
# with LongMemEval's own prompts. Defaults: reader = RIKI_CHAT_MODEL, judge = the
# official gpt-4o-2024-08-06. Each may point at another provider.
# READER_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-2024-08-06
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...
